<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LifeDashboard.Views"
    x:Class="LifeDashboard.MainPage"
    BackgroundColor="#f8fafc"
    Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackground">#f8fafc</Color>
            <Color x:Key="CardBackground">#ffffff</Color>
            <Color x:Key="CardBorder">#e2e8f0</Color>
            <Color x:Key="PrimaryText">#0f172a</Color>
            <Color x:Key="MutedText">#64748b</Color>
            <Color x:Key="Accent">#2563eb</Color>
            <Color x:Key="AccentAlt">#7c3aed</Color>
            <Color x:Key="Success">#16a34a</Color>
            <Color x:Key="Warning">#d97706</Color>
            <Style x:Key="CardFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                <Setter Property="BorderColor" Value="{StaticResource CardBorder}" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="HasShadow" Value="True" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
                <Setter Property="CharacterSpacing" Value="0.5" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" RowDefinitions="Auto,*">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#f8fafc" Offset="0" />
                        <GradientStop Color="#f1f5f9" Offset="0.5" />
                        <GradientStop Color="#e2e8f0" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid Padding="20" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Life Dashboard"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Accent}"
                            CharacterSpacing="1.1" />
                        <Label
                            Text="Your daily focus, streaks, and progress in one place."
                            FontSize="12"
                            TextColor="{StaticResource MutedText}" />
                    </VerticalStackLayout>

                    <Frame
                        Grid.Column="1"
                        BackgroundColor="#e2e8f0"
                        BorderColor="#cbd5e1"
                        CornerRadius="16"
                        Padding="12"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                            <Label
                                x:Name="DateLabel"
                                FontSize="11"
                                TextColor="{StaticResource MutedText}"
                                FontAttributes="Bold" />
                            <Label
                                x:Name="TimeLabel"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryText}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Frame Style="{StaticResource CardFrame}" Padding="14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Focus" FontSize="11" TextColor="{StaticResource MutedText}" />
                                <Label
                                    Text="3 priorities"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource PrimaryText}" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="1" Style="{StaticResource CardFrame}" Padding="14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Momentum" FontSize="11" TextColor="{StaticResource MutedText}" />
                                <Label
                                    Text="Streak ready"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AccentAlt}" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </Grid>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20" Spacing="18">
                    <Frame Style="{StaticResource CardFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                            <Frame
                                BackgroundColor="#e2e8f0"
                                BorderColor="#cbd5e1"
                                CornerRadius="18"
                                Padding="0"
                                WidthRequest="78"
                                HeightRequest="78"
                                HasShadow="False">
                                <Label Text="✨" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>

                            <VerticalStackLayout Spacing="6">
                                <Label
                                    x:Name="LevelLabel"
                                    Text="Level 0"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Accent}" />
                                <Label
                                    x:Name="XpLabel"
                                    Text="0 / 100 XP"
                                    FontSize="12"
                                    TextColor="{StaticResource MutedText}" />
                                <Label
                                    x:Name="XpPercentLabel"
                                    Text="0%"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AccentAlt}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="10" Margin="0,16,0,0">
                            <ProgressBar
                                x:Name="XpProgressBar"
                                Progress="0"
                                HeightRequest="10"
                                ProgressColor="{StaticResource Accent}"
                                BackgroundColor="#e2e8f0" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Text="Leveling" FontSize="10" TextColor="{StaticResource MutedText}" />
                                <BoxView Grid.Column="1" />
                                <Label Grid.Column="2" Text="Next milestone" FontSize="10" TextColor="{StaticResource MutedText}" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10" Margin="0,16,0,0">
                            <Label Text="Badges" Style="{StaticResource SectionTitle}" />
                            <HorizontalStackLayout x:Name="BadgesContainer" Spacing="10" Padding="4" />
                        </VerticalStackLayout>
                    </Frame>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="14">
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="📋" FontSize="20" />
                                    <Label Text="Tasks" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" />
                                </HorizontalStackLayout>
                                <Label
                                    x:Name="TaskStatsLabel"
                                    Text="0/0"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Success}" />
                                <ProgressBar
                                    x:Name="TaskProgressBar"
                                    Progress="0"
                                    HeightRequest="6"
                                    ProgressColor="{StaticResource Success}"
                                    BackgroundColor="#e2e8f0" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="1" Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="🎯" FontSize="20" />
                                    <Label Text="Habits" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" />
                                </HorizontalStackLayout>
                                <Label
                                    x:Name="HabitStatsLabel"
                                    Text="0/0"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Warning}" />
                                <ProgressBar
                                    x:Name="HabitProgressBar"
                                    Progress="0"
                                    HeightRequest="6"
                                    ProgressColor="{StaticResource Warning}"
                                    BackgroundColor="#e2e8f0" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <Frame Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="10">
                                <Frame
                                    BackgroundColor="#e2e8f0"
                                    BorderColor="#c4b5fd"
                                    CornerRadius="12"
                                    Padding="8"
                                    HasShadow="False"
                                    WidthRequest="44"
                                    HeightRequest="44">
                                    <Label Text="💡" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Coach" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentAlt}" />
                                    <Label Text="Daily motivation + micro advice" FontSize="11" TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Label
                                x:Name="CoachTipLabel"
                                Text="Loading tips..."
                                FontSize="12"
                                TextColor="{StaticResource PrimaryText}"
                                LineBreakMode="WordWrap"
                                LineHeight="1.4" />

                            <Button
                                Text="Refresh Tip"
                                x:Name="GetTipButton"
                                Clicked="OnGetCoachTip"
                                BackgroundColor="#e2e8f0"
                                TextColor="{StaticResource AccentAlt}"
                                FontSize="12"
                                Padding="12,10"
                                BorderColor="#c4b5fd"
                                BorderWidth="1"
                                CornerRadius="12"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Activity Heatmap" Style="{StaticResource SectionTitle}" />
                        <Frame Style="{StaticResource CardFrame}" Padding="16">
                            <local:HeatmapView x:Name="HeatmapView" />
                        </Frame>
                    </VerticalStackLayout>

                    <Frame Style="{StaticResource CardFrame}" BorderColor="#1d4ed8">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Add Task" Style="{StaticResource SectionTitle}" />
                            <HorizontalStackLayout Spacing="10">
                                <Entry
                                    x:Name="TaskEntry"
                                    Placeholder="What needs to get done?"
                                    BackgroundColor="#e2e8f0"
                                    TextColor="{StaticResource PrimaryText}"
                                    PlaceholderColor="{StaticResource MutedText}"
                                    HorizontalOptions="FillAndExpand"
                                    FontSize="13" />

                                <Button
                                    Text="Add"
                                    Clicked="OnAddTask"
                                    BackgroundColor="#2563eb"
                                    TextColor="#ffffff"
                                    CornerRadius="12"
                                    WidthRequest="70"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="0" />
                            </HorizontalStackLayout>

                            <CollectionView x:Name="TaskList" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <SwipeView>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <SwipeItem
                                                        Text="Delete"
                                                        BackgroundColor="#dc2626"
                                                        Invoked="OnDeleteTask" />
                                                </SwipeItems>
                                            </SwipeView.RightItems>

                                            <Frame
                                                BackgroundColor="#e2e8f0"
                                                BorderColor="#cbd5e1"
                                                CornerRadius="14"
                                                Padding="12"
                                                Margin="0,6"
                                                HasShadow="False"
                                                BorderWidth="1">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <CheckBox
                                                        IsChecked="{Binding IsCompleted}"
                                                        CheckedChanged="OnTaskCheckedChanged"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Title}"
                                                        TextColor="{StaticResource PrimaryText}"
                                                        VerticalOptions="Center"
                                                        FontSize="13" />

                                                    <Button
                                                        Grid.Column="2"
                                                        Text="🗑"
                                                        Clicked="OnDeleteTaskButton"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#f87171"
                                                        Padding="8"
                                                        FontSize="14" />
                                                </Grid>
                                            </Frame>
                                        </SwipeView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Style="{StaticResource CardFrame}" BorderColor="#b45309">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Add Habit" Style="{StaticResource SectionTitle}" />
                            <HorizontalStackLayout Spacing="10">
                                <Entry
                                    x:Name="HabitEntry"
                                    Placeholder="Build a daily routine"
                                    BackgroundColor="#e2e8f0"
                                    TextColor="{StaticResource PrimaryText}"
                                    PlaceholderColor="{StaticResource MutedText}"
                                    HorizontalOptions="FillAndExpand"
                                    FontSize="13" />

                                <Button
                                    Text="Add"
                                    Clicked="OnAddHabit"
                                    BackgroundColor="#d97706"
                                    TextColor="#ffffff"
                                    CornerRadius="12"
                                    WidthRequest="70"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="0" />
                            </HorizontalStackLayout>

                            <CollectionView x:Name="HabitList" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame
                                            BackgroundColor="#e2e8f0"
                                            BorderColor="#cbd5e1"
                                            CornerRadius="14"
                                            Padding="12"
                                            Margin="0,6"
                                            HasShadow="False"
                                            BorderWidth="1">
                                            <HorizontalStackLayout Spacing="12">
                                                <CheckBox
                                                    IsChecked="{Binding IsCompleted}"
                                                    CheckedChanged="OnHabitCheckedChanged"
                                                    VerticalOptions="Center" />

                                                <VerticalStackLayout HorizontalOptions="FillAndExpand" Spacing="4">
                                                    <Label
                                                        Text="{Binding Title}"
                                                        TextColor="{StaticResource PrimaryText}"
                                                        FontSize="13"
                                                        FontAttributes="Bold" />

                                                    <Label
                                                        Text="{Binding Streak, StringFormat='🔥 {0} day streak'}"
                                                        TextColor="{StaticResource Warning}"
                                                        FontSize="11" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <BoxView HeightRequest="36" BackgroundColor="Transparent" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            IsVisible="False"
            x:Name="OverlayGrid"
            InputTransparent="True"
            BackgroundColor="Transparent">
            <local:ConfettiView x:Name="ConfettiView" />
        </Grid>

        <local:LevelUpPopup
            x:Name="LevelUpPopup"
            AbsoluteLayout.LayoutBounds="0.5,0.5,0.85,0.7"
            AbsoluteLayout.LayoutFlags="PositionProportional,SizeProportional"
            InputTransparent="True" />
    </AbsoluteLayout>
</ContentPage>
